# ===== Runtime & Locale =====
NODE_ENV=development
APP_PORT=3000
TZ=Australia/Adelaide
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# ===== Database (MySQL) =====
DB_HOST=db
DB_PORT=3306
DB_NAME=sophia
DB_USER=sophia
DB_PASSWORD=sophia_pw
# Sequelize pool (optional)
DB_POOL_MIN=0
DB_POOL_MAX=10

# ===== Auth =====
# Choose: mock | firebase
AUTH_PROVIDER=mock

# For mock provider (tests/dev only)
MOCK_JWT_SECRET=test-secret

# For Firebase (if/when you switch to real auth)
FIREBASE_PROJECT_ID=
FIREBASE_EMULATOR_HOST= # e.g., localhost:9099 (leave empty if not using emulator)
FIREBASE_AUDIENCE=      # e.g., https://securetoken.google.com/<project-id>

# ===== Storage (Evidence) =====
# Choose: s3 | filesystem
STORAGE_DRIVER=s3

# S3/MinIO (dev defaults assume compose service named "minio")
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=sophia-evidence
S3_ACCESS_KEY=dev
S3_SECRET_KEY=dev
# Client upload policy
EVIDENCE_ALLOWED_MIME=image/jpeg,image/png,application/pdf,video/mp4
EVIDENCE_MAX_BYTES=10485760        # 10 MB
# Signed URL TTLs (minutes)
SIGNED_URL_TTL_MIN=10              # PUT (upload)
EVIDENCE_SIGNED_GET_TTL_MIN=5      # GET (view)

# Optional: if using filesystem storage in dev (ignored when STORAGE_DRIVER=s3)
FS_STORAGE_ROOT=./.local/evidence

# ===== Reports (HTML → PDF) =====
REPORTS_PDF_ENABLED=true
REPORTS_PDF_LOCALE=en-AU
# If you prefer a system Chrome instead of bundled Chromium, set:
PUPPETEER_EXECUTABLE_PATH=

# ===== Billing / Paywall =====
BILLING_ENABLED=true
TRIAL_DAYS=14
PLAN_HOMESCHOOL_MONTHLY=homeschool_monthly

# ===== Feature Flags (safe defaults) =====
FEATURE_PLANNING=true
FEATURE_EVIDENCE=true
FEATURE_QUIZZES=true
FEATURE_REPORTS=true

# ===== App Secrets & Misc (dev-safe) =====
# Never log signed URLs or raw secrets in production.
REDIS_URL=                         # optional if you add queues later
SESSION_SECRET=dev-session-secret  # only if you add sessions
